{
  "uid": "energy-waste-demo",
  "title": "Energy & Waste Demo",
  "tags": [
    "kepler",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "zone",
        "label": "Kepler zone",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kepler_node_cpu_watts, zone)",
          "refId": "zones"
        },
        "definition": "label_values(kepler_node_cpu_watts, zone)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "package",
          "value": "package"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU: requested vs used (cores)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"demo\",resource=\"cpu\"})",
          "legendFormat": "requested",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"demo\",container!=\"\",container!=\"POD\"}[2m]))",
          "legendFormat": "used",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "What the scheduler reserves vs what the containers really burn. The gap is the waste."
    },
    {
      "id": 2,
      "title": "Waste ratio (requested CPU not used)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 5,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(rate(container_cpu_usage_seconds_total{namespace=\"demo\",container!=\"\",container!=\"POD\"}[2m]))) / (sum(kube_pod_container_resource_requests{namespace=\"demo\",resource=\"cpu\"}))",
          "legendFormat": "waste",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Memory: requested vs used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 7,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"demo\",resource=\"memory\"})",
          "legendFormat": "requested",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(container_memory_working_set_bytes{namespace=\"demo\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "used (working set)",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Replicas available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"demo\",deployment=\"demo-app\"})",
          "legendFormat": "replicas",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Nodes running demo pods",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 8,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (node)(kube_pod_info{namespace=\"demo\",pod=~\"demo-app-.*\"}))",
          "legendFormat": "nodes",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Node-equivalents of CPU: requested vs used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"demo\",resource=\"cpu\"}) / avg(kube_node_status_allocatable{resource=\"cpu\"})",
          "legendFormat": "requested",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"demo\",container!=\"\",container!=\"POD\"}[2m])) / avg(kube_node_status_allocatable{resource=\"cpu\"})",
          "legendFormat": "used",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "CPU reserved (or used) expressed as a fraction of one node's allocatable CPU."
    },
    {
      "id": 7,
      "title": "Safety: restarts and OOMKills",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"demo\"})",
          "legendFormat": "restarts",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_status_last_terminated_reason{namespace=\"demo\",reason=\"OOMKilled\"}) or vector(0)",
          "legendFormat": "OOMKilled",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Must stay flat after right-sizing. If these climb, the requests were cut too far."
    },
    {
      "id": 8,
      "title": "Kepler: demo pods power (W)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kepler_pod_cpu_watts{pod_namespace=\"demo\",zone=\"$zone\"})",
          "legendFormat": "demo pods",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "options": {},
      "description": "Active CPU power Kepler attributes to the demo pods. Idle power is not attributed to workloads."
    },
    {
      "id": 9,
      "title": "Kepler: node active vs idle power (W)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kepler_node_cpu_active_watts{zone=\"$zone\"})",
          "legendFormat": "active",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kepler_node_cpu_idle_watts{zone=\"$zone\"})",
          "legendFormat": "idle",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "options": {},
      "description": "The idle part belongs to the machine. It only goes away when the machine does."
    },
    {
      "id": 10,
      "title": "Energy in selected time range (Wh)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kepler_pod_cpu_joules_total{pod_namespace=\"demo\",zone=\"$zone\"}[$__range])) / 3600",
          "legendFormat": "demo pods",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kepler_node_cpu_joules_total{zone=\"$zone\"}[$__range])) / 3600",
          "legendFormat": "all nodes",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watth"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none"
      }
    }
  ]
}
